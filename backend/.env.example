# Copy to .env and fill in real values. .env is gitignored - never commit it.

# Optional. Unset (or absent) uses a local SQLite file - fine for solo
# dev/demo. Set to a postgresql://user:password@host:port/dbname URL to use
# Postgres instead; see scripts/migrate_sqlite_to_postgres.py for a one-time
# copy of existing SQLite data when switching an already-populated dev DB.
DATABASE_URL=

# JWT signing key. Falls back to a public dev-only value if unset - override
# before any real deployment (see app/security.py).
JWT_SECRET_KEY=change-me-to-a-long-random-value

# Where the frontend is served from, used to build links inside emails
# (verify-email / reset-password). Defaults to the Vite dev server.
FRONTEND_URL=http://localhost:5173

# SMTP for verification/reset emails. If SMTP_HOST is unset, the app falls
# back to logging the email to the console instead of sending it - safe for
# local dev with zero configuration. For Gmail: use an App Password
# (https://myaccount.google.com/apppasswords), not your normal password -
# rotate it if it's ever pasted somewhere it shouldn't be (e.g. a chat log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM_ADDRESS=

# Required to register with role="teacher" - registration fails closed (500)
# if this is unset, so teacher self-registration can't silently stay open.
# Give this code only to people who should have teacher access.
TEACHER_INVITE_CODE=change-me-to-a-shared-secret

# Notified by email whenever someone successfully registers as a teacher
# (using a valid invite code). Leave unset to skip the notification.
ADMIN_EMAIL=
